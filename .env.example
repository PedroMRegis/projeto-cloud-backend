# Copie para .env para ligar a busca semântica em local.
# A chave NUNCA vai para o repositório: na AWS ela vem do Parameter Store.
EMBEDDINGS_PROVIDER=none      # none | bedrock | gemini
GEMINI_API_KEY=
# Liga o login. Em local, o cookie precisa de AUTH_COOKIE_SECURE=false (HTTP).
# O chatbot precisa do mesmo AUTH_JWT_SECRET.
AUTH_JWT_SECRET=
AUTH_COOKIE_SECURE=false
# Habilita /api/admin/* em local.
ADMIN_TOKEN=dev-admin-token
